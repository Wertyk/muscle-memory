# Ollama Cloud, OpenAI-compatible provider. Set AGENT_ENGINE to ai-sdk:openai
# and OPENAI_BASE_URL to https://ollama.com/v1. Never put credentials in source.
# Exact measured model recommendations and commands: ../../benchmarks/ollama-2026-11-01.md
AGENT_ENGINE=
AGENT_MODEL=
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Separate cheap model for the server-side completeText extraction boundary.
EXTRACT_MODEL=

# Local development authentication override (optional)
AUTH_DISABLED=

# Production authentication and database
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
DATABASE_URL=
