{
  "extends": "@agent-native/core/tsconfig.base.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "rootDirs": [
      ".",
      "./.react-router/types"
    ],
    "paths": {
      "*": [
        "./*"
      ],
      "@/*": [
        "./app/*"
      ],
      "@shared/*": [
        "./shared/*"
      ]
    }
  },
  "include": [
    "app/**/*",
    "server/**/*",
    "shared/**/*",
    "scripts/**/*",
    "e2e/**/*",
    "playwright.config.ts",
    "../../scripts/llm/**/*.ts",
    "../../scripts/mechanisms/**/*.ts",
    "vite.config.ts",
    "react-router.config.ts",
    ".react-router/types/**/*",
    ".generated/**/*",
    "actions/**/*",
    "agent-native.config.ts",
    "vitest.config.ts"
  ]
}
